{
  "name": "librewolf-agent-bridge-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, local-first MCP automation for LibreWolf.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/browser-core && npm run build --workspace @librewolf-agent-bridge/native-host && npm run build --workspace librewolf-agent-bridge",
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "lint": "eslint .",
    "format": "prettier --write \"apps/**/*.{ts,js,mjs,json,md}\" \"packages/**/*.{ts,js,mjs,json,md}\" \"extension/**/*.{ts,js,mjs,json,md,html}\" \"scripts/**/*.{ts,js,mjs,json,md}\" \"tests/**/*.{ts,js,mjs,json,md}\" \"docs/**/*.{json,md}\" \"packaging/**/*.{ts,js,mjs,json,md}\" \"*.{ts,js,mjs,json,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,js,mjs,json,md}\" \"packages/**/*.{ts,js,mjs,json,md}\" \"extension/**/*.{ts,js,mjs,json,md,html}\" \"scripts/**/*.{ts,js,mjs,json,md}\" \"tests/**/*.{ts,js,mjs,json,md}\" \"docs/**/*.{json,md}\" \"packaging/**/*.{ts,js,mjs,json,md}\" \"*.{ts,js,mjs,json,md}\"",
    "compatibility:spike": "node scripts/compatibility-spike.mjs",
    "benchmark": "vitest bench --run",
    "profile:performance": "node scripts/profile-performance.mjs",
    "package:all": "node scripts/package-artifacts.mjs",
    "validate:plugin": "python C:/Users/Maxim/.codex/skills/.system/plugin-creator/scripts/validate_plugin.py packaging/codex-plugin/librewolf-agent-bridge"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
